<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 主主题 -->
    <style name="Theme.CubeLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Splash 主题（遮罩动画） -->
    <style name="Theme.CubeLauncher.Splash" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.CubeLauncher</item>
    </style>
</resources>
